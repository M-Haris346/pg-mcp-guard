# Copy to .env and replace every change-me. Never commit .env.
# JWT_SECRET is added in Phase 4.

# Superuser for the local dev container only.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

APP_ENV=dev
LOG_LEVEL=INFO

# Role passwords, read by db/bootstrap/00_bootstrap.sh on first container start.
MCP_MIGRATOR_PASSWORD=change-me
MCP_READER_PASSWORD=change-me
MCP_AUDITOR_PASSWORD=change-me

# HMAC key for the signed RLS context: 64 hex chars (32 bytes).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MCP_CONTEXT_KEY=change-me

# Keep the passwords below in sync with the ones above.
MIGRATOR_DATABASE_URL=postgresql://mcp_migrator:change-me@127.0.0.1:5432/mcpguard
READER_DATABASE_URL=postgresql://mcp_reader:change-me@127.0.0.1:5432/mcpguard
AUDITOR_DATABASE_URL=postgresql://mcp_auditor:change-me@127.0.0.1:5432/mcpguard

# Tests use a separate database; the suite migrates and seeds it itself.
TEST_MIGRATOR_DATABASE_URL=postgresql://mcp_migrator:change-me@127.0.0.1:5432/mcpguard_test
TEST_READER_DATABASE_URL=postgresql://mcp_reader:change-me@127.0.0.1:5432/mcpguard_test
TEST_AUDITOR_DATABASE_URL=postgresql://mcp_auditor:change-me@127.0.0.1:5432/mcpguard_test
